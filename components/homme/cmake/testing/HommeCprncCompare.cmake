# Compare netcdf files with cprnc. Usage:
#   cmake -DCPRNC=<cprnc> -DSRC_DIR=<dir> -DFILES=<f1,f2,...> -DTGT_DIR=<dir> [-DTGT_FILES=<g1,g2,...>]
#         [-DTOL=<tol>] [-DLOG_PREFIX=<prefix>] -P HommeCprncCompare.cmake
# For each i, compares ${SRC_DIR}/FILES[i] against ${TGT_DIR}/TGT_FILES[i] (TGT_FILES defaults to FILES).
# The cprnc output is saved in <prefix>.<file>.out (in the current dir).
# Two files pass the comparison if
#  - TOL is not set: cprnc says they are IDENTICAL, and no variable is missing from either file
#  - TOL is set: cprnc says they are IDENTICAL, or all the normalized RMS differences are <= TOL

cmake_minimum_required (VERSION 3.16)

foreach (var IN ITEMS CPRNC SRC_DIR FILES TGT_DIR)
  if (NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message (FATAL_ERROR "HommeCprncCompare.cmake: missing variable ${var}")
  endif()
endforeach()
string (REPLACE "," ";" FILES "${FILES}")
if (DEFINED TGT_FILES AND NOT "${TGT_FILES}" STREQUAL "")
  string (REPLACE "," ";" TGT_FILES "${TGT_FILES}")
else()
  set (TGT_FILES ${FILES})
endif()
if (NOT DEFINED LOG_PREFIX)
  set (LOG_PREFIX cprnc)
endif()

set (nfails 0)
set (idx 0)
foreach (f IN LISTS FILES)
  list (GET TGT_FILES ${idx} tgt)
  math (EXPR idx "${idx} + 1")
  set (src_file ${SRC_DIR}/${f})
  set (tgt_file ${TGT_DIR}/${tgt})
  if (NOT EXISTS ${tgt_file})
    message ("FAIL: ${f}: file ${tgt_file} not found")
    math (EXPR nfails "${nfails} + 1")
    continue()
  endif()
  if (NOT EXISTS ${src_file})
    message ("FAIL: ${f}: file ${src_file} not found")
    math (EXPR nfails "${nfails} + 1")
    continue()
  endif()

  get_filename_component (fname ${f} NAME)
  set (log ${LOG_PREFIX}.${fname}.out)
  execute_process (COMMAND ${CPRNC} -m ${tgt_file} ${src_file}
                   OUTPUT_FILE ${log} ERROR_VARIABLE cprnc_err RESULT_VARIABLE res)
  file (READ ${log} cprnc_out)

  set (ok FALSE)
  if (cprnc_out MATCHES "diff_test: the two files seem to be IDENTICAL")
    # Fields missing from either file count as a failure (unless a tolerance is given)
    string (REGEX MATCHALL "A total number of +[0-9]+ [a-z -]*fields on file [12] +were not found" missing "${cprnc_out}")
    set (nmissing 0)
    foreach (line IN LISTS missing)
      string (REGEX REPLACE "A total number of +([0-9]+) .*" "\\1" n "${line}")
      if (n GREATER 0)
        math (EXPR nmissing "${nmissing} + 1")
      endif()
    endforeach()
    if (nmissing EQUAL 0 OR DEFINED TOL)
      set (ok TRUE)
      message ("PASS: ${f} is IDENTICAL to ${tgt_file}")
    else()
      message ("FAIL: ${f} has the same values as ${tgt_file}, but some variables are missing (see ${log})")
    endif()
  elseif (DEFINED TOL)
    string (REGEX MATCHALL "RMS +[^ \n]+ +[^ \n]+ +NORMALIZED +[^ \n]+" rms_lines "${cprnc_out}")
    if (NOT rms_lines)
      message ("FAIL: ${f} differs from ${tgt_file}, but cprnc reported no RMS differences (see ${log})")
    else()
      set (ok TRUE)
      foreach (line IN LISTS rms_lines)
        string (REGEX REPLACE ".*NORMALIZED +" "" rms "${line}")
        # cmake can't compare floats: use the (exact) comparison of awk, as the old scripts did
        execute_process (COMMAND awk "BEGIN{ print ( ${rms} <= ${TOL} ) }" OUTPUT_VARIABLE within OUTPUT_STRIP_TRAILING_WHITESPACE)
        if (NOT within STREQUAL "1")
          set (ok FALSE)
          message ("FAIL: ${f}: ${line} (tolerance: ${TOL})")
        endif()
      endforeach()
      if (ok)
        message ("PASS: ${f} matches ${tgt_file} within tolerance ${TOL}")
      endif()
    endif()
  else()
    string (REGEX MATCHALL "RMS [^\n]*" rms_lines "${cprnc_out}")
    list (JOIN rms_lines "\n  " rms_lines)
    message ("FAIL: ${f} differs from ${tgt_file} (see ${log}). RMS differences:\n  ${rms_lines}")
  endif()
  if (NOT ok)
    math (EXPR nfails "${nfails} + 1")
  endif()
endforeach()

if (nfails GREATER 0)
  message (FATAL_ERROR "${nfails} file(s) failed the comparison")
endif()
