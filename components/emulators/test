#!/bin/bash
#
# Test script for emulator_comps
# Builds and runs unit tests
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="${SCRIPT_DIR}/build"

# Source utilities
source "${SCRIPT_DIR}/scripts/shell/colors.sh"
source "${SCRIPT_DIR}/scripts/shell/parse_args.sh"

# Parse command line arguments
parse_test_args "$@"

# Clean only mode
if [ "$CLEAN_ONLY" = true ]; then
    print_status "Cleaning build directory..."
    rm -rf "${BUILD_DIR}"
    print_status "Done."
    exit 0
fi

# Create build directory
mkdir -p "${BUILD_DIR}"

# Configure (only if needed, or to apply new -D options to an existing build)
if [ ! -f "${BUILD_DIR}/CMakeCache.txt" ]; then
    print_status "Configuring CMake..."
    cmake -S "${SCRIPT_DIR}" -B "${BUILD_DIR}" -DCMAKE_BUILD_TYPE=Debug  \
    -DEMULATOR_ENABLE_TESTS=ON \
    -DSTANDALONE_MODE=ON \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -DFETCHCONTENT_BASE_DIR="$SCRIPT_DIR/downloads" \
    -DEMULATOR_ENABLE_LIBTORCH=ON \
    -DEMULATOR_ENABLE_PYTHON=ON \
    "${CMAKE_ARGS[@]}" || {
    # Remove the partial cache so that the next run configures again
    rm -f "${BUILD_DIR}/CMakeCache.txt"
    exit 1
    }
elif [ "${#CMAKE_ARGS[@]}" -gt 0 ]; then
    print_status "Reconfiguring CMake..."
    cmake -S "${SCRIPT_DIR}" -B "${BUILD_DIR}" "${CMAKE_ARGS[@]}"
fi

# Build
print_status "Building..."
cmake --build "${BUILD_DIR}" --parallel

# Build only mode - exit before running tests
if [ "$BUILD_ONLY" = true ]; then
    print_status "Build complete."
    exit 0
fi

# Run tests
print_status "Running tests..."
ctest_args=(--test-dir "${BUILD_DIR}" --output-on-failure)
if [ "$VERBOSE" = true ]; then
    ctest_args+=(--verbose)
fi
if [ -n "$TEST_REGEX" ]; then
    ctest_args+=(-R "$TEST_REGEX")
fi
ctest "${ctest_args[@]}"

print_status "All tests passed!"
