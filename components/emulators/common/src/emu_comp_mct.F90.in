module @COMPONENT@_comp_mct
   !------------------------------------------------------------------------
   ! Thin Fortran wrapper for all emulator components.
   !
   ! Provides the MCT interface (@COMPONENT@_init_mct, @COMPONENT@_run_mct, @COMPONENT@_final_mct)
   ! and delegates calls to the underlying C++ emulator implementation.
   !------------------------------------------------------------------------

   use esmf
   use mct_mod
   use seq_cdata_mod,    only: seq_cdata, seq_cdata_setptrs
   use seq_infodata_mod, only: seq_infodata_type, &
                               seq_infodata_getdata, &
                               seq_infodata_putdata
   use seq_timemgr_mod,  only: seq_timemgr_EClockGetData
   use seq_flds_mod,     only: seq_flds_a2x_fields, &
                               seq_flds_x2a_fields
   use seq_comm_mct,     only: seq_comm_inst, seq_comm_name, &
                               seq_comm_suffix
   use shr_kind_mod,     only: IN=>SHR_KIND_IN, R8=>SHR_KIND_R8, &
                               CL=>SHR_KIND_CL
   use shr_file_mod,     only: shr_file_getunit, shr_file_setIO, &
                               shr_file_getLogUnit, &
                               shr_file_setLogUnit
   use shr_sys_mod,      only: shr_sys_flush
   use iso_c_binding
   use coupler_types,    only: emulator_grid_desc, emulator_create_cfg, &
                               coupling_desc, &
                               create_config, create_grid_desc
   use emulator_f2c_api, only: emulator_create, emulator_set_grid_data, &
                               emulator_setup_coupling, emulator_init, &
                               emulator_run, emulator_finalize, &
                               emulator_get_nx, emulator_get_ny, &
                               emulator_get_num_local_cols, emulator_get_num_global_cols, &

   implicit none
   private

   public :: @COMPONENT@_init_mct
   public :: @COMPONENT@_run_mct
   public :: @COMPONENT@_final_mct

   integer                :: comm
   integer(IN)            :: my_task
   integer                :: inst_index
   character(len=16)      :: inst_name
   character(len=16)      :: inst_suffix = ""
   integer(IN)            :: emulator_id
   integer(IN), parameter :: master_task = 0
   integer                :: log_unit

   type(c_ptr) :: emulators
CONTAINS

   !==========================================================================
   subroutine @COMPONENT@_init_mct(EClock, cdata, x2a, a2x, NLFilename)

      type(ESMF_Clock),           intent(inout) :: EClock
      type(seq_cdata),            intent(inout) :: cdata
      type(mct_aVect),            intent(inout) :: x2a, a2x
      character(len=*), optional, intent(in)    :: NLFilename

      type(seq_infodata_type), pointer :: infodata
      type(mct_gsMap),         pointer :: gs_map
      type(mct_gGrid),         pointer :: domain
      integer(IN)   :: phase, ierr, lsize
      integer(IN)   :: cur_ymd, cur_tod
      character(CL) :: run_type
      character(kind=c_char, len=256), target :: input_file_c
      character(kind=c_char, len=256), target :: log_file_c
      character(kind=c_char, len=256), target :: calendar_c
      character(kind=c_char, len=256), target :: import_fields_c
      character(kind=c_char, len=256), target :: export_fields_c
      character(len=256)        :: log_file_f
      character(len=256)        :: calendar_f
      integer(c_int)            :: run_type_c
      integer                   :: shrlogunit
      type(emulator_create_cfg) :: cfg
      type(coupling_desc)       :: cpl

      call seq_cdata_setptrs(cdata, &
                             id       = emulator_id, &
                             comm     = comm, &
                             gsmap    = gs_map,
                             dom      = domain, &
                             infodata = infodata)

      call seq_infodata_getdata(infodata, &
                                @COMPONENT@_phase = phase, &
                                start_type        = run_type)
      call seq_infodata_putdata(infodata, &
                                @COMPONENT@_prognostic = .true.)

      if (phase > 1) return

      inst_name   = seq_comm_name(emulator_id)
      inst_index  = seq_comm_inst(emulator_id)
      inst_suffix = seq_comm_suffix(emulator_id)

      call MPI_Comm_rank(comm, my_task, ierr)

      if (my_task == master_task) then
         log_unit = shr_file_getunit()
         call shr_file_setIO( &
            '@COMPONENT@_modelio.nml'//trim(inst_suffix), log_unit)
      else
         log_unit = 6
      endif

      ! redirect shared-lib logging to log file
      call shr_file_getLogUnit(shrlogunit)
      call shr_file_setLogUnit(log_unit)

      if (my_task == master_task) then
         write(log_unit,*) '(@EMULATOR_NAME@) ====================='
         write(log_unit,*) '(@EMULATOR_NAME@) @COMPONENT@_init_mct starting'
         write(log_unit,*) '(@EMULATOR_NAME@) ====================='
         call shr_sys_flush(log_unit)
      endif

      if (trim(run_type) == 'startup') then
         run_type_c = 0
      else if (trim(run_type) == 'continue') then
         run_type_c = 1
      else if (trim(run_type) == 'branch') then
         run_type_c = 2
      else
         run_type_c = 0
      endif

      call seq_timemgr_EClockGetData(EClock, calendar=calendar_f, &
         curr_ymd=cur_ymd, curr_tod=cur_tod, &
         start_ymd=case_start_ymd, start_tod=case_start_tod)

      input_file_c = "@COMPONENT@_in"//trim(inst_suffix)//C_NULL_CHAR

      log_file_c = C_NULL_CHAR
      if (my_task == master_task) then
         inquire(unit=log_unit, name=log_file_f)
         log_file_c = trim(log_file_f)//C_NULL_CHAR
      endif

      calendar_c = trim(calendar_f)//C_NULL_CHAR

      cfg = create_config(f_comm     = comm, &
                          comp_id    = emulator_id, &
                          run_type   = run_type_c, &
                          start_ymd  = cur_ymd, &
                          start_tod  = cur_tod, &
                          input_file = input_file_c, &
                          log_file   = log_file_c, &
                          calendar   = calendar_c)
      emulators = emulator_create(kind = '@COMPONENT@'//C_NULL_CHAR, &
                                  cfg  = cfg)
      call emulator_set_grid(emulators, grid)

      call set_gs_map_mct(emulators, comm, emulator_id, gs_map)
      lsize = mct_gsMap_lsize(gs_map, comm)

      call set_domain_mct(emulators, lsize, gs_map, domain)

      ! FIXME: MOAB registration happens here in EAMxx. Can we move it to emulator_create?

      ! Initialize MCT attribute vectors
      call mct_aVect_init(x2a, rList=seq_flds_x2a_fields, lsize=lsize)
      call mct_aVect_init(a2x, rList=seq_flds_a2x_fields, lsize=lsize)
      call mct_aVect_zero(x2a)
      call mct_aVect_zero(a2x)

      ! Build null-terminated field strings for C
      export_fields_c = trim(seq_flds_a2x_fields)//C_NULL_CHAR
      import_fields_c = trim(seq_flds_x2a_fields)//C_NULL_CHAR

      ! Initialize coupling indices in C++
      !call emulator_init_coupling_indices(emulators, &
      !   c_loc(import_fields_c), c_loc(export_fields_c))

      ! Build coupling descriptor directly (x2a%rAttr is rank-2: nflds x lsize)
      cpl%import_data = c_loc(x2a%rAttr(1,1))
      cpl%export_data = c_loc(a2x%rAttr(1,1))
      cpl%num_imports = mct_aVect_nRattr(x2a)
      cpl%num_exports = mct_aVect_nRattr(a2x)
      cpl%field_size  = lsize

      ! Setup coupling buffers
      call emulator_setup_coupling(emulators, cpl)

      ! Initialize the emulator
      call emulator_init(emulators)

      call seq_infodata_PutData(infodata, &
         @COMPONENT@_nx=emulator_get_nx(emulators), &
         @COMPONENT@_ny=emulator_get_ny(emulators))

      if (my_task == master_task) then
         write(log_unit,*) '(@EMULATOR_NAME@) @COMPONENT@_init_mct complete'
         write(log_unit,*) '(@EMULATOR_NAME@)   nx  =', &
            emulator_get_nx(emulators)
         write(log_unit,*) '(@EMULATOR_NAME@)   ny  =', &
            emulator_get_ny(emulators)
         write(log_unit,*) '(@EMULATOR_NAME@)   nloc=', &
            emulator_get_num_local_cols(emulators)
         write(log_unit,*) '(@EMULATOR_NAME@)   nglb=', &
            emulator_get_num_global_cols(emulators)
         call shr_sys_flush(log_unit)
      endif

      ! Restore shared-lib log unit
      call shr_file_setLogUnit(shrlogunit)

   end subroutine @COMPONENT@_init_mct

   !==========================================================================
   subroutine @COMPONENT@_run_mct(EClock, cdata, x2a, a2x)

      type(ESMF_Clock), intent(inout) :: EClock
      type(seq_cdata),  intent(inout) :: cdata
      type(mct_aVect),  intent(inout) :: x2a, a2x

      type(seq_infodata_type), pointer :: infodata
      integer  :: dt, shrlogunit
      real(R8) :: nextsw_cday

      call seq_cdata_setptrs(cdata, infodata=infodata)
      call seq_timemgr_EClockGetData(EClock, &
         next_cday=nextsw_cday, dtime=dt)

      ! Redirect shared-lib logging to log file
      call shr_file_getLogUnit(shrlogunit)
      call shr_file_setLogUnit(log_unit)

      call emulator_run(emulators, int(dt,c_int))

      call seq_infodata_PutData(infodata, nextsw_cday=nextsw_cday)

      ! Restore shared-lib log unit
      call shr_file_setLogUnit(shrlogunit)

   end subroutine @COMPONENT@_run_mct

   !==========================================================================
   subroutine @COMPONENT@_final_mct(EClock, cdata, x2a, a2x)

      type(ESMF_Clock), intent(inout) :: EClock
      type(seq_cdata),  intent(inout) :: cdata
      type(mct_aVect),  intent(inout) :: x2a, a2x

      if (my_task == master_task) then
         write(log_unit,*) '(@EMULATOR_NAME@) @COMPONENT@_final_mct starting'
         call shr_sys_flush(log_unit)
      endif

      call emulator_finalize(emulators)

      if (my_task == master_task) then
         write(log_unit,*) '(@EMULATOR_NAME@) @COMPONENT@_final_mct complete'
         call shr_sys_flush(log_unit)
      endif

   end subroutine @COMPONENT@_final_mct

   !==========================================================================
   subroutine set_gs_map_mct(emu, comm, emulator_id, gs_map)

      use, intrinsic :: iso_c_binding, only : c_ptr, c_int

      type(c_ptr),     intent(in)  :: emu
      integer,         intent(in)  :: comm
      integer,         intent(in)  :: emulator_id
      type(mct_gsMap), intent(out) :: gs_map

      integer(c_int) :: num_local_cols, num_global_cols
      integer(c_int), allocatable, target :: col_gids(:)

      ! Query grid sizes from emulator
      num_local_cols  = emulator_get_num_local_cols(emu)
      num_global_cols = emulator_get_num_global_cols(emu)

      allocate(col_gids(num_local_cols))

      ! Get local global-IDs from emulator
      call emulator_get_local_col_gids(emu, col_gids)
      call mct_gsMap_init(gs_map, col_gids, comm, &
         emulator_id, num_local_cols, num_global_cols)

      deallocate(col_gids)

   end subroutine set_gs_map_mct

   !==========================================================================
   subroutine set_domain_mct(emu, lsize, gs_map, domain)

      use, intrinsic :: iso_c_binding, only : c_ptr, c_int
      use shr_kind_mod, only : R8 => SHR_KIND_R8

      type(c_ptr),      intent(in)    :: emu
      integer,          intent(in)    :: lsize
      type(mct_gsMap),  intent(in)    :: gs_map
      type(mct_gGrid),  intent(inout) :: domain

      integer,  pointer :: idata(:)
      real(R8), pointer :: data1(:), data2(:)

      allocate(data1(lsize))
      allocate(data2(lsize))

      call mct_gGrid_init(GGrid=domain, &
         CoordChars='lat:lon:hgt', &
         OtherChars='area:aream:mask:frac', &
         lsize=lsize)

      ! Global column ids for local points
      call mct_gsMap_orderedPoints(gs_map, my_task, idata)
      call mct_gGrid_importIAttr(domain, 'GlobGridNum', idata, lsize)

      data1(:) = -9999.0_R8
      call mct_gGrid_importRAttr(domain, "lat",  data1, lsize)
      call mct_gGrid_importRAttr(domain, "lon",  data1, lsize)
      call mct_gGrid_importRAttr(domain, "area", data1, lsize)
      call mct_gGrid_importRAttr(domain, "aream",data1, lsize)

      ! Get geometry from emulator
      call emulator_get_cols_latlon(emu, data1, data2)
      call mct_gGrid_importRAttr(domain, "lat", data1, lsize)
      call mct_gGrid_importRAttr(domain, "lon", data2, lsize)

      call emulator_get_cols_area(emu, data1)
      call mct_gGrid_importRAttr(domain, "area",  data1, lsize)
      call mct_gGrid_importRAttr(domain, "aream", data1, lsize)

      data1(:) = 1.0_R8
      call mct_gGrid_importRAttr(domain, "mask", data1, lsize)
      call mct_gGrid_importRAttr(domain, "frac", data1, lsize)

      deallocate(data1)
      deallocate(data2)
      if (associated(idata)) deallocate(idata)

   end subroutine set_domain_mct

end module @COMPONENT@_comp_mct
