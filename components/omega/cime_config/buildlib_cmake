#!/usr/bin/env python3

import os
import sys

_CIMEROOT = os.environ.get("CIMEROOT")
if _CIMEROOT is None:
    _MSG = "ERROR: must set CIMEROOT environment variable"
    raise SystemExit(_MSG)

_LIBDIR = os.path.join(_CIMEROOT, "CIME", "Tools")
sys.path.append(_LIBDIR)

from CIME.buildlib import parse_input
from CIME.case import Case
from standard_script_setup import *

logger = logging.getLogger(__name__)  # noqa: F405


def buildlib(bldroot, installpath, case):
    """ """
    print("building omega")

    metis_root = os.environ["METIS_ROOT"]
    parmetis_root = os.environ["PARMETIS_ROOT"]

    cmake_args = (
        f" -DOMEGA_BUILD_MODE=E3SM"
        f' -DOMEGA_METIS_ROOT="{metis_root}"'
        f' -DOMEGA_PARMETIS_ROOT="{parmetis_root}"'
    )

    comp_interface = case.get_value("COMP_INTERFACE")
    if comp_interface == "moab":
        moab_root = os.environ.get("MOAB_ROOT")
        if not moab_root or not os.path.exists(moab_root):
            _MSG = (
                "\nERROR: MOAB_ROOT environmental variable is not set to a "
                "valid directory. \n\n\tA valid MOAB_ROOT value is needed "
                "when using the MOAB driver.\n\tPlease set a valid MOAB_ROOT "
                "in the cime_config/machines/config_machines.xml file."
            )
            raise SystemExit(_MSG)
        cmake_args += f' -DOMEGA_MOAB_ROOT="{moab_root}"'

    print(f"omega cmake options: '{cmake_args}'")

    return cmake_args


def _main(argv, documentation):
    """ """
    caseroot, libroot, bldroot = parse_input(sys.argv)
    with Case(caseroot, read_only=False) as case:
        buildlib(bldroot, libroot, case)


if __name__ == "__main__":
    _main(sys.argv, __doc__)
