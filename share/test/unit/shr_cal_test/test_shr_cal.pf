         dateIN = date_in, secIN = sec_in, &
         dateOUT = date_out, secOUT = sec_out, &
         calendar = 'noleap')

    @assertEqual(98760316, date_out)
    @assertEqual(99._r8, sec_out, tolerance=tol)
