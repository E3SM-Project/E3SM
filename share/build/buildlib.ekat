#!/usr/bin/env python3

import os, sys, argparse, logging

from standard_script_setup import *
from CIME import utils
from CIME.utils import expect, run_bld_cmd_ensure_logging
from CIME.case import Case

sys.path.append(os.path.dirname(__file__))
from buildlib_util import (config_if_not_configured, get_external_lib_root, get_kokkos_build_info,
                           is_lib_installed, setup_intelgpu_nvcc_workaround, use_trilinos_kokkos)

logger = logging.getLogger(__name__)

###############################################################################
def parse_command_line(args, description):
###############################################################################
    parser = argparse.ArgumentParser(
        usage="""\n{0} [--debug]
OR
{0} --verbose
OR
{0} --help

\033[1mEXAMPLES:\033[0m
    \033[1;32m# Run \033[0m
    > {0}
""".format(
            os.path.basename(args[0])
        ),
        description=description,
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )

    utils.setup_standard_logging_options(parser)

    parser.add_argument("buildroot", help="build path root")

    parser.add_argument("installpath", help="install path ")

    parser.add_argument(
        "caseroot", nargs="?", default=os.getcwd(), help="Case directory to build"
    )

    args = utils.parse_args_and_handle_standard_logging_options(args, parser)

    return args.buildroot, args.installpath, args.caseroot

###############################################################################
def buildlib(bldroot, installpath, case):
###############################################################################

    ekat_root = get_external_lib_root("Ekat")
    if ekat_root is not None:
        # We are trying to use a pre-installed ekat. Look for the relevant folders/libs,
        # and if all looks good, return. Otherwise, crap out
        include_dir = os.path.join(ekat_root,'include')

        expect (os.path.isdir(include_dir),f"Missing include subfolder in ekat install dir '{ekat_root}'")
        expect (os.path.isdir(os.path.join(include_dir,"ekat")),f"Missing ekat headers in '{include_dir}'")

        return
    else:
        print ("no value found in env for Ekat_ROOT. building from scratch")

    srcroot = os.path.abspath(case.get_value("SRCROOT"))
    ekat_dir = os.path.join(srcroot, "externals", "ekat")
    expect(os.path.isdir(ekat_dir), "Missing ekat submodule")

    # Ekat is built against a pre-built Kokkos, which should have been installed by the
    # kokkos lib (which the case must list before ekat in CASE_SUPPORT_LIBRARIES).
    use_trilinos_kokkos(case)
    kokkos_root = get_external_lib_root("Kokkos")
    if kokkos_root is None:
        expect(is_lib_installed("Kokkos", installpath),
               f"Kokkos is not installed in '{installpath}'. The kokkos lib must be built before ekat: "
               "make sure 'kokkos' comes before 'ekat' in CASE_SUPPORT_LIBRARIES.")
        kokkos_root = installpath

    # Ekat does not configure Kokkos (it uses the installed one), so we only need the compilers
    cc, cxx, _ = get_kokkos_build_info(case)

    # Just enable all ekat packages?
    ekat_cmake_options = f"-DEKAT_ENABLE_ALL_PACKAGES=On -DEKAT_ENABLE_TESTS=Off -DKokkos_ROOT={kokkos_root}"
    if case.get_value("MPILIB") == "mpi-serial":
        ekat_cmake_options += " -DEKAT_ENABLE_MPI=Off"
    if case.get_value("DEBUG"):
        ekat_cmake_options += " -DCMAKE_BUILD_TYPE=Debug"

    gen_makefile_cmd = f"cmake {cc} {cxx} {ekat_cmake_options} -DCMAKE_INSTALL_PREFIX={installpath} {ekat_dir}"

    # Same as for Kokkos (see buildlib.kokkos): to prevent find_package from picking
    # up a build folder in install_sharedpath, we use ${bldroot}/build as a binary
    # dir, so that CMake won't consider it when executing find_package.
    bldroot = f"{bldroot}/build"
    if not os.path.isdir(bldroot):
        os.makedirs(bldroot)

    # Ekat sources may be compiled with nvcc_wrapper too
    setup_intelgpu_nvcc_workaround(case, bldroot)

    config_if_not_configured("EKAT", bldroot, gen_makefile_cmd, logger)

    gmake_j = case.get_value("GMAKE_J")
    run_bld_cmd_ensure_logging(
        f"cmake --build . -v -j {gmake_j}", logger, from_dir=bldroot
    )
    run_bld_cmd_ensure_logging("cmake --install .", logger, from_dir=bldroot)

###############################################################################
def _main(argv, documentation):
###############################################################################
    bldroot, installpath, caseroot = parse_command_line(argv, documentation)
    with Case(caseroot, read_only=False) as case:
        buildlib(bldroot, installpath, case)

###############################################################################
if __name__ == "__main__":
    _main(sys.argv, __doc__)
