#!/usr/bin/env python3

"""
A script to parse an e3sm build log and report per-target build times and memory usage.

This scans the provided log file for lines emitted by e3sm_compile_wrap.py
of the form:

    Target XXX built in Y.Z seconds, peak memory: M.N MB

and prints them sorted by build time (longest last).

If a second log file is provided, the script instead reports how each
target's build time and peak memory have changed between the two logs, along with the
change in total build time and memory. The first log file will be considered the
reference and the second will be the compare.
"""

import sys, re, argparse

TARGET_RE = re.compile(r"^Target (.+) built in (\d+(?:\.\d+)?) seconds(?:, peak memory: (\d+(?:\.\d+)?) MB)?\s*$")

GREEN = "\033[32m"
RED   = "\033[31m"
RESET = "\033[0m"

###############################################################################
def colorize(text, pct):
###############################################################################
    if pct is None:
        return text
    if pct <= -10.0:
        return f"{GREEN}{text}{RESET}"
    if pct >= 10.0:
        return f"{RED}{text}{RESET}"
    return text

###############################################################################
def parse_log(filepath, sort_by="time"):
###############################################################################
    entries = []
    with open(filepath, "r") as fd:
        for line in fd:
            m = TARGET_RE.match(line.strip())
            if m is not None:
                target = m.group(1)
                time_sec = float(m.group(2))
                memory_mb = float(m.group(3)) if m.group(3) is not None else None
                entries.append((target, time_sec, memory_mb))

    if sort_by == "memory":
        entries.sort(key=lambda item: (item[2] if item[2] is not None else 0.0, item[1]))
    else:
        entries.sort(key=lambda item: item[1])
    return entries

###############################################################################
def compare_logs(logfile1, logfile2, sort_by="time"):
###############################################################################
    entries1_list = parse_log(logfile1, sort_by)
    entries2_list = parse_log(logfile2, sort_by)

    entries1 = {target: (time_sec, memory_mb) for target, time_sec, memory_mb in entries1_list}
    entries2 = {target: (time_sec, memory_mb) for target, time_sec, memory_mb in entries2_list}

    all_targets = set(entries1) | set(entries2)

    diffs = []
    for target in all_targets:
        t1_data = entries1.get(target)
        t2_data = entries2.get(target)
        t1 = t1_data[0] if t1_data is not None else None
        m1 = t1_data[1] if t1_data is not None else None
        t2 = t2_data[0] if t2_data is not None else None
        m2 = t2_data[1] if t2_data is not None else None
        delta = (t2 if t2 is not None else 0.0) - (t1 if t1 is not None else 0.0)
        mem_delta = (m2 if m2 is not None else 0.0) - (m1 if m1 is not None else 0.0)
        diffs.append((target, t1, t2, delta, m1, m2, mem_delta))

    diffs.sort(key=lambda item: (item[1] if item[1] is not None else item[2]))

    for target, t1, t2, delta, m1, m2, mem_delta in diffs:
        t1_str = f"{t1:f}" if t1 is not None else "MISSING"
        t2_str = f"{t2:f}" if t2 is not None else "MISSING"
        m1_str = f"{m1:.1f}" if m1 is not None else "MISSING"
        m2_str = f"{m2:.1f}" if m2 is not None else "MISSING"

        if t1 is not None and t1 > 0.0 and t2 is not None:
            pct = (delta / t1) * 100.0
            pct_str = f"{pct:+.2f}%"
        else:
            pct = None
            pct_str = "N/A"

        if m1 is not None and m1 > 0.0 and m2 is not None:
            mem_pct = (mem_delta / m1) * 100.0
            mem_pct_str = f"{mem_pct:+.2f}%"
        else:
            mem_pct = None
            mem_pct_str = "N/A"

        line = (
            f"Target {target}: {t1_str} -> {t2_str} seconds "
            f"(delta {delta:+f}, {pct_str}), "
            f"{m1_str} -> {m2_str} MB (delta {mem_delta:+.1f}, {mem_pct_str})"
        )
        print(colorize(line, pct))

    total1 = sum(item[0] for item in entries1_list)
    total2 = sum(item[0] for item in entries2_list)
    total_delta = total2 - total1
    if total1 > 0.0:
        total_pct = (total_delta / total1) * 100.0
        total_pct_str = f"{total_pct:+.2f}%"
    else:
        total_pct = None
        total_pct_str = "N/A"

    total_mem1 = sum((item[2] if item[2] is not None else 0.0) for item in entries1_list)
    total_mem2 = sum((item[2] if item[2] is not None else 0.0) for item in entries2_list)
    total_mem_delta = total_mem2 - total_mem1
    if total_mem1 > 0.0:
        total_mem_pct = (total_mem_delta / total_mem1) * 100.0
        total_mem_pct_str = f"{total_mem_pct:+.2f}%"
    else:
        total_mem_pct = None
        total_mem_pct_str = "N/A"

    total_line = (
        f"\nTotal: {total1:f} -> {total2:f} seconds "
        f"(delta {total_delta:+f}, {total_pct_str}), "
        f"{total_mem1:.1f} -> {total_mem2:.1f} MB (delta {total_mem_delta:+.1f}, {total_mem_pct_str})"
    )
    print(colorize(total_line, total_pct))

###############################################################################
def parse_command_line(args, description):
###############################################################################
    parser = argparse.ArgumentParser(
        usage=f"{args[0]} <build-log-file> [<build-log-file2>]",
        description=description,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument("logfile", help="Path to the build log file to parse")

    parser.add_argument(
        "logfile2",
        nargs="?",
        default=None,
        help="Optional second build log file. When provided, the script "
             "compares per-target and total build times between the two logs.",
    )

    parser.add_argument(
        "--sort-by",
        choices=["time", "memory"],
        default="time",
        help="Sort targets by 'time' (default) or 'memory'",
    )

    return parser.parse_args(args[1:])

###############################################################################
def _main_func(description):
###############################################################################
    args = parse_command_line(sys.argv, description)

    if args.logfile2 is None:
        entries = parse_log(args.logfile, sort_by=args.sort_by)
        for target, seconds, memory_mb in entries:
            if memory_mb is not None:
                print(f"Target {target} built in {seconds:f} seconds, peak memory: {memory_mb:.1f} MB")
            else:
                print(f"Target {target} built in {seconds:f} seconds")
        total_time = sum(item[1] for item in entries)
        total_mem = sum((item[2] if item[2] is not None else 0.0) for item in entries)
        print(f"\nTotal: {total_time:f} seconds, {total_mem:.1f} MB")

    else:
        compare_logs(args.logfile, args.logfile2, sort_by=args.sort_by)

###############################################################################

if __name__ == "__main__":
    _main_func(__doc__)
