#!/bin/bash

#
# Wrapper around jenkins_generic_job that will allow output
# from that script to always be printed to the screen and
# recoverable if Jenkins is forced to kill the job. This is the
# script that should be used from Jenkins.
#

SCRIPT_DIR=$( cd "$( dirname "$0" )" && pwd )
DATE_STAMP=$(date "+%Y-%m-%d_%H%M%S")
export JENKINS_START_TIME=$(date "+%s")

umask 002

# Run the jenkins job in a robust way (network drops won't stop it)
nohup $SCRIPT_DIR/../../cime/CIME/Tools/jenkins_generic_job --submit-to-cdash --update-success "$@" < /dev/null >& JENKINS_${DATE_STAMP} &
JOB_PID=$!

# Stream the log file in real-time, exiting automatically when the job ends
tail -f --pid=$JOB_PID JENKINS_${DATE_STAMP}

# Wait for the job to reap its exit status and respect 'pipefail'
wait $JOB_PID
